# NotificationService environment example
PORT=3002
HOST=0.0.0.0

# Auth
# SERVICE_TOKEN is used for internal S2S Bearer auth
SERVICE_TOKEN=change-me-strong-token
# Optional: PEM formatted RSA public key for verifying incoming JWTs
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Email providers (ordered for failover): smtp,mock
EMAIL_PROVIDER=smtp,mock
EMAIL_FROM=no-reply@example.com

# SMTP configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Retry/backoff
NOTIF_MAX_ATTEMPTS=3
NOTIF_BASE_DELAY_MS=500

# Localization
NOTIF_LOCALES=en,fr,es
