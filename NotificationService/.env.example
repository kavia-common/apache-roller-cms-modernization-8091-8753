# Core service
PORT=3002
HOST=0.0.0.0
NODE_ENV=development

# Authentication
# Service-to-service Bearer token for internal calls (REQUIRED in non-dev)
SERVICE_TOKEN=changeme-strong-token

# Optional JWT verification public key (PEM). If set, JWTs will be verified and roles enforced.
# Paste PEM public key as a single line with \n escapes or use file-based loading in your runtime.
JWT_PUBLIC_KEY=

# RBAC is inferred from roles[] in JWT. SERVICE_TOKEN grants 'service' role.

# Email providers (ordered, comma-separated for failover)
# Supported: smtp, mock
EMAIL_PROVIDER=smtp,mock

# Default From
EMAIL_FROM=no-reply@example.com

# SMTP configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Retry/backoff
NOTIF_MAX_ATTEMPTS=3
NOTIF_BASE_DELAY_MS=500

# Localization
NOTIF_LOCALES=en,fr,es

# Optional audience hint for upstream integrators
BACKEND_AUDIENCE=express-backend
